<?xml version="1.0" encoding="utf-8"?><!--
    Cloud backup and device-to-device transfer: playlists, favorites, settings
    and the lyrics cache are included — nothing sensitive is stored by the app.

    The saved playback queue is left out: it holds MediaStore row ids, which
    differ on another device and would restore the wrong tracks.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/playback_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/playback_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
